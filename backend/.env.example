# Backend environment (backend/.env) — NEVER commit this file.
# Copy to backend/.env and fill in real values locally.

# Gemini API key (server-side only; never sent to the browser).
# When absent, the agent returns a graceful fallback instead of erroring.
GEMINI_API_KEY=

# Primary model (default: gemini-3.5-flash-lite — free tier, 500 RPD).
GEMINI_MODEL=gemini-3.5-flash-lite

# Fallback model used when the primary is rate-limited (429).
# Default: gemini-3.1-flash-lite (free tier, 500 RPD — own quota bucket).
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Optional: shared bridge key checked via the x-api-key header.
# Required when NODE_ENV=production.
API_KEY=

# Optional: node environment. /admin CRM is 403 outside development.
NODE_ENV=development

# Optional: HTTP port (default 3000).
PORT=3000

# Optional: SQLite dev file path (default ./data/dev.sqlite).
SQLITE_PATH=./data/dev.sqlite

# Admin CRM credentials — REQUIRED outside development.
# /admin is open in dev; in production it requires HTTP basic auth with these
# values. If unset in production, /admin fails closed (503).
ADMIN_USER=
ADMIN_PASS=

# admin-video-analyze: YouTube cookies for the server-side yt-dlp pipeline.
# Needed on datacenter IPs (YouTube bot-checks them; impersonation alone is
# not enough). The file must be on a READ-WRITABLE volume: yt-dlp saves the
# cookie jar back on exit (keeps rotated cookies fresh) and a read-only
# path aborts with OSError 30. In prod the file lives OUTSIDE git at
# /opt/vidasaludable/data/secrets/youtube-cookies.txt → inside the
# container it is /app/data/secrets/youtube-cookies.txt:
# YT_COOKIES_PATH=/app/data/secrets/youtube-cookies.txt
