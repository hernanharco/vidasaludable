FROM node:22-slim

# Native build tools for better-sqlite3 (node-gyp fallback when no prebuild).
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json pnpm-lock.yaml ./
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate && pnpm install --frozen-lockfile || pnpm install

COPY . .
RUN pnpm build

ENV NODE_ENV=production

CMD ["node", "dist/index.js"]