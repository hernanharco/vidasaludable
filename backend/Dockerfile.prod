FROM node:22-slim

# Native build tools for better-sqlite3 (node-gyp fallback when no prebuild)
# + runtime deps for the server-side video pipeline (admin-video-analyze S5):
# ffmpeg (media tools), ca-certificates (yt-dlp's HTTPS) and python3-pip
# (yt-dlp itself, installed below).
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip make g++ ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# yt-dlp via pip WITH curl_cffi → TLS impersonation of a real browser. The
# standalone binary has no impersonation target, and YouTube bot-checks the
# server's datacenter IP (prod incident 2026-10-25: "Sign in to confirm
# you're not a bot" for every extraction). Verified probe: with curl_cffi
# the same IP extracts normally. `[default]` pulls yt-dlp's standard deps;
# --break-system-packages because Debian 12 marks the system env
# externally-managed (PEP 668). The JS runtime for yt-dlp's EJS challenges
# is the image's own node (passed by media.ts as --js-runtimes node).
RUN python3 -m pip install --break-system-packages --no-cache-dir \
    "yt-dlp[default]" curl_cffi

WORKDIR /app

COPY package.json pnpm-lock.yaml ./
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate && pnpm install --frozen-lockfile --ignore-scripts && pnpm rebuild better-sqlite3

COPY . .
RUN pnpm build

ENV NODE_ENV=production

CMD ["node", "dist/index.js"]